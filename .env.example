# AB-XQL-PM backend — exemplo de configuracao (Docs/rules/01-credential-security.md:
# nunca commitar um .env real com segredo de verdade).

# TimescaleDB / PostgreSQL de persistencia da aplicacao (nao confundir com instancias monitoradas).
DATABASE_URL=postgresql+asyncpg://ab_xql_pm:changeme@localhost:5432/ab_xql_pm

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Prefixo/base do cofre de segredos usado para resolver encrypted_credential_ref
# (Docs/rules/01-credential-security.md — referencia, nunca a senha em si).
CREDENTIAL_VAULT_BASE_URL=

# Chave Fernet usada para cifrar/decifrar o fallback de credencial (auth_method=encrypted_fallback).
# Obrigatoria (sem default) — deve viver fora do banco, nunca commitar o valor real. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

ENVIRONMENT=development

# Timeout por query de coleta (segundos) e limite de linhas truncado em Python apos o fetch —
# coleta somente leitura, nunca deve travar ou sobrecarregar a instancia monitorada
# (Docs/rules/02-safe-collection.md).
COLLECTION_QUERY_TIMEOUT_SECONDS=5.0
COLLECTION_MAX_ROWS=5000

# Limites da API de leitura (endpoints de metrics/queries/waits-blocking) contra a hypertable
# propria da aplicacao — diferente de COLLECTION_MAX_ROWS, que e do lado da coleta contra a
# instancia monitorada. Limite de linhas por resposta e janela padrao (segundos) quando o
# cliente nao informa `from`/`to`.
API_READ_MAX_ROWS=2000
API_READ_DEFAULT_LOOKBACK_SECONDS=3600

# Tamanho do thread pool padrao do event loop (toda chamada `asyncio.to_thread` do processo -
# pymssql/pyodbc sao sincronos). O default do proprio Python (min(32, cpu_count+4)) e baixo
# demais para varias instancias reais coletando em paralelo, especialmente com
# polling_interval_seconds agressivo (1-2s) em mais de uma instancia ao mesmo tempo.
BACKEND_EXECUTOR_MAX_WORKERS=64

# Thread pool DEDICADO por instancia SQL Server (app/core/instance_executors.py) - uma chamada
# pymssql travada (sem timeout confiavel de socket/SO) so esgota a capacidade DAQUELA instancia,
# nunca de outras. Pequeno de proposito - ver docstring do modulo.
INSTANCE_EXECUTOR_MAX_WORKERS=6

# Liga o supervisor de coleta continua (PollingSupervisor) no lifespan do backend. Default
# false - nunca ligar coleta real fora de um ambiente explicitamente configurado para isso.
POLLING_SUPERVISOR_ENABLED=false

# Liga a coleta de missing indexes. Necessario para atualizar registros existentes com
# avg_user_impact (percentual de melhoria) e avg_total_user_cost (custo medio).
MISSING_INDEX_SUPERVISOR_ENABLED=false

# Intervalo entre coletas de missing indexes; a primeira coleta ocorre ao iniciar o backend.
MISSING_INDEX_CHECK_INTERVAL_SECONDS=86400

# Intervalo (segundos) de reconciliacao de instancias ativas pelo supervisor.
SUPERVISOR_DISCOVERY_INTERVAL_SECONDS=15

# A partir de quantos minutos aberta uma transacao vira candidata a "orfa" na tela de
# Transacoes (so destaque/ordenacao, nunca fecha a transacao de verdade).
TRANSACTION_ORPHAN_THRESHOLD_MINUTES=5

# Por quanto tempo reter transacoes/bloqueios ja ENCERRADOS e deadlocks antes de expurgar de vez
# (log de incidente retido para analise posterior — nunca apagado so por ter "resolvido").
PROBLEM_EVENTS_RETENTION_DAYS=90

# Liga o worker de expurgo por idade (ProblemEventsRetentionWorker) no lifespan do backend.
PROBLEM_EVENTS_RETENTION_WORKER_ENABLED=false
PROBLEM_EVENTS_RETENTION_CHECK_INTERVAL_SECONDS=86400

# Liga o supervisor de extracao de deadlocks (DeadlockSupervisor, so SQL Server) no lifespan do
# backend.
DEADLOCK_SUPERVISOR_ENABLED=false
DEADLOCK_CHECK_INTERVAL_SECONDS=300
# Ler o target `event_file` (.xel em disco) e mais lento que o antigo ring_buffer em memoria -
# timeout proprio, bem maior que o das coletas de alta frequencia.
DEADLOCK_QUERY_TIMEOUT_SECONDS=30

# Liga o supervisor de captura confiavel de erro por transacao (TransactionErrorSupervisor, so
# SQL Server - cria/mantem uma sessao Extended Events dedicada, exige permissao de servidor
# ALTER ANY EVENT SESSION) no lifespan do backend.
TRANSACTION_ERROR_SUPERVISOR_ENABLED=false
TRANSACTION_ERROR_CHECK_INTERVAL_SECONDS=120
TRANSACTION_ERROR_QUERY_TIMEOUT_SECONDS=30

# Liga o worker de avaliacao continua de alertas (AlertingWorker) no lifespan do backend. Default
# false - nunca ligar avaliacao real fora de um ambiente explicitamente configurado para isso.
ALERTING_WORKER_ENABLED=false

# Intervalo (segundos) entre ciclos de avaliacao de alert_rules.
ALERTING_EVALUATION_INTERVAL_SECONDS=60

# Intervalo (segundos) minimo entre lembretes de um alerta critico nao reconhecido.
ALERT_CRITICAL_REMINDER_INTERVAL_SECONDS=900

# URL do webhook de notificacao de alerta. Vazio = canal webhook desabilitado (notificacao so
# logada nesse canal).
ALERT_WEBHOOK_URL=

# Base URL da instancia do AB SQL Insight (painel "Analise SQL Insight" no detalhe de query).
# Vazio = capacidade desligada (painel nao aparece, sem erro). Ex.: http://autklinux4:9100
SQL_INSIGHT_BASE_URL=
SQL_INSIGHT_TIMEOUT_SECONDS=3.0

# Canal de e-mail de notificacao de alerta. Todos vazios por padrao = canal desabilitado. So
# ALERT_SMTP_HOST habilita o envio real; ALERT_EMAIL_TO (lista separada por virgula) precisa
# estar preenchido para ter destinatario de verdade.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_EMAIL_TO=

# Fase 2, item 2 (rule_type="custom_sql") - timeout de QUERY para a execucao periodica de SQL
# customizado escrito pelo usuario.
CUSTOM_SQL_ALERT_TIMEOUT_SECONDS=5.0

# Fase 2, item 2 (catalogo de alertas expandido: freespace + replicacao) - liga o worker de
# baixa frequencia que coleta essas metricas (ExtendedHealthMetricsSupervisor).
EXTENDED_HEALTH_METRICS_SUPERVISOR_ENABLED=false
EXTENDED_HEALTH_METRICS_CHECK_INTERVAL_SECONDS=3600

# Fase 2, item 5 (rule_type="plan_compile_timeout") - liga o worker de baixa frequencia que
# escaneia o cache de planos do SQL Server (PlanCompileTimeoutSupervisor). So SQL Server.
PLAN_COMPILE_TIMEOUT_SUPERVISOR_ENABLED=false
PLAN_COMPILE_TIMEOUT_CHECK_INTERVAL_SECONDS=86400
