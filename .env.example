# AB-XQL-PM backend — exemplo de configuracao (Docs/rules/01-credential-security.md:
# nunca commitar um .env real com segredo de verdade).

# TimescaleDB / PostgreSQL de persistencia da aplicacao (nao confundir com instancias monitoradas).
DATABASE_URL=postgresql+asyncpg://ab_xql_pm:changeme@localhost:5432/ab_xql_pm

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Prefixo/base do cofre de segredos usado para resolver encrypted_credential_ref
# (Docs/rules/01-credential-security.md — referencia, nunca a senha em si).
CREDENTIAL_VAULT_BASE_URL=

# Chave Fernet usada para cifrar/decifrar o fallback de credencial (auth_method=encrypted_fallback).
# Obrigatoria (sem default) — deve viver fora do banco, nunca commitar o valor real. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

ENVIRONMENT=development

# Timeout por query de coleta (segundos) e limite de linhas truncado em Python apos o fetch —
# coleta somente leitura, nunca deve travar ou sobrecarregar a instancia monitorada
# (Docs/rules/02-safe-collection.md).
COLLECTION_QUERY_TIMEOUT_SECONDS=5.0
COLLECTION_MAX_ROWS=5000

# Limites da API de leitura (endpoints de metrics/queries/waits-blocking) contra a hypertable
# propria da aplicacao — diferente de COLLECTION_MAX_ROWS, que e do lado da coleta contra a
# instancia monitorada. Limite de linhas por resposta e janela padrao (segundos) quando o
# cliente nao informa `from`/`to`.
API_READ_MAX_ROWS=2000
API_READ_DEFAULT_LOOKBACK_SECONDS=3600
